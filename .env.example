# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Elastic Beanstalk
EB_APPLICATION_NAME=spikeshield-app
EB_ENVIRONMENT_NAME=spikeshield-prod

# Redis
REDIS_URL=redis://redis:6379

# SQS
SQS_RUNBOOK_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/YOUR_ACCOUNT_ID/spikeshield-runbooks

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Mock AWS (true = run locally without AWS creds)
MOCK_AWS=true

# App
DEBUG=true
