# SpikeShield Environment Config
APP_NAME=SpikeShield
APP_VERSION=1.0.0
DEBUG=False

# AWS Config
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EB_APPLICATION_NAME=
EB_ENVIRONMENT_NAME=
MOCK_AWS=True

# Services
REDIS_URL=redis://localhost:6379
SQS_RUNBOOK_QUEUE_URL=
SLACK_WEBHOOK_URL=

# App Settings
VELOCITY_WINDOW_SECONDS=60
VELOCITY_SPIKE_THRESHOLD=2.5
PREWARM_MINUTES_BEFORE_EVENT=20
ERROR_BUDGET_THRESHOLD_PCT=1.0
CLOUDWATCH_POLLING_INTERVAL_SECONDS=30
